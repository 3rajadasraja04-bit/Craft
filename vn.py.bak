#  WEBSOCKET MANAGER
# ═══════════════════════════════════════════════════════════════════════
class WSManager:
    def __init__(self): self.clients = set()
    async def broadcast(self, msg):
        dead = set()
        for ws in list(self.clients):
            try: await ws.send_json(msg)
            except Exception: dead.add(ws)
        self.clients -= dead

ws_mgr = WSManager()
_main_loop: asyncio.AbstractEventLoop | None = None

def _push_ws(msg):
    if _main_loop and not _main_loop.is_closed():
        try: asyncio.run_coroutine_threadsafe(ws_mgr.broadcast(msg), _main_loop)
        except Exception: pass

# ═══════════════════════════════════════════════════════════════════════
#  LOG HELPERS
# ═══════════════════════════════════════════════════════════════════════
def _emit(kind, msg, style="cyan", icon="ℹ"):
    ts = datetime.now().strftime("%H:%M:%S")
    entry = {"ts": ts, "msg": msg, "style": style, "icon": icon}
    if kind == "err": STATE["error_logs"].append(entry)
    else:             STATE["logs"].append(entry)
    _push_ws({"type": kind, "data": entry})

def hdr(t):  _emit("log", t, "purple", "⚡")
def ok(m):   _emit("log", m, "green", "✅")
def info(m): _emit("log", m, "cyan", "💠")
def warn(m): _emit("err", m, "amber", "⚠️"); STATE["total_errors"] += 1
def err(m):  _emit("err", m, "red", "❌");   STATE["total_errors"] += 1

