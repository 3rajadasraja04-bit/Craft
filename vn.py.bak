def _enc_varint_sync(n):
    if n < 0: return b''
    out = []
    while True:
        b = n & 0x7F; n >>= 7
        if n: b |= 0x80
        out.append(b)
        if not n: break
    return bytes(out)
def _varint_field_sync(fn, v): return _enc_varint_sync((fn << 3) | 0) + _enc_varint_sync(v)
def _length_field_sync(fn, v):
    d = v.encode() if isinstance(v, str) else v
    return _enc_varint_sync((fn << 3) | 2) + _enc_varint_sync(len(d)) + d
def _build_proto_sync(fields):
    buf = bytearray()
    for f, v in fields.items():
        if isinstance(v, dict): buf.extend(_length_field_sync(f, _build_proto_sync(v)))
        elif isinstance(v, int): buf.extend(_varint_field_sync(f, v))
        elif isinstance(v, (str, bytes)): buf.extend(_length_field_sync(f, v))
    return bytes(buf)
def _first_varint(data, want):
    off = 0
    while off < len(data):
        try:
            key = shift = 0
            while True:
                b = data[off]; off += 1
                key |= (b & 0x7F) << shift
                if not (b & 0x80): break
                shift += 7
        except Exception: break
        fn, wt = key >> 3, key & 7
        try:
            if wt == 0:
                v = shift = 0
                while True:
                    b = data[off]; off += 1
                    v |= (b & 0x7F) << shift
                    if not (b & 0x80): break
                    shift += 7
                if fn == want: return v
            elif wt == 2:
                ln = shift = 0
                while True:
                    b = data[off]; off += 1
                    ln |= (b & 0x7F) << shift
                    if not (b & 0x80): break
                    shift += 7
                off += ln
            elif wt == 1: off += 8
            elif wt == 5: off += 4
            else: break
        except Exception: break
    return None

JWT_TTL = 6 * 3600
def load_jwt_cache():
    if not os.path.exists(JWT_CACHE_FILE): return {}
    try:
        with open(JWT_CACHE_FILE, "r", encoding="utf-8") as f: return json.load(f)
    except Exception: return {}
def save_jwt_cache(uid, data):
    cache = load_jwt_cache(); dc = dict(data)
    if isinstance(dc.get("key"), bytes): dc["key"] = dc["key"].hex()
    if isinstance(dc.get("iv"), bytes):  dc["iv"]  = dc["iv"].hex()
    now = time.time(); dc["created_at"] = now; dc["expires_at"] = now + JWT_TTL; dc["saved_at"] = now
    cache[str(uid)] = dc
    try:
        with open(JWT_CACHE_FILE, "w", encoding="utf-8") as f: json.dump(cache, f, indent=4)
    except Exception: pass

async def execute_social_action(idx, uid, acc_id, action_type, target, pwd, is_auto=False, map_name=""):
    if idx not in STATE["social"]:
        STATE["social"][idx] = {"uid": acc_id or uid, "action": action_type,
                                 "target": target, "status": "Wait", "map": map_name}
    else:
        STATE["social"][idx].update({"action": action_type, "target": target,
                                      "status": "Wait", "map": map_name})
    cache = load_jwt_cache(); s = cache.get(str(uid))
    is_valid = False
    if s:
        if "expires_at" in s: is_valid = time.time() < s["expires_at"]
        elif "saved_at" in s: is_valid = (time.time() - s["saved_at"]) < JWT_TTL
    if not is_valid or not s or "jwt" not in s:
        STATE["social"][idx]["status"] = "Logging in"
        try:
            s = await asyncio.to_thread(login, uid, pwd); save_jwt_cache(uid, s)
        except Exception:
            STATE["social"][idx]["status"] = "Login Fail"; return

    jwt = s["jwt"]; region = s.get("region", "IND").upper()
    base_url = "https://client.ind.freefiremobile.com/" if region == "IND" else \
               ("https://client.us.freefiremobile.com/" if region in ("BR","US","NA","SAC")
                else "https://clientbp.ppmainecoonghj.com/")
    try:
        if action_type == "Follow":
            proto = _build_proto_sync({1: int(target), 2: 4}); endpoint = "/Follow"
        elif action_type == "Subscribe":
            clean = str(target).strip()
            if clean.startswith("#"): clean = clean[1:]
            clean = clean.replace("FREEFIRE", "")
            if "/" in clean: clean = clean.split("/")[0]
            clean = clean.strip().upper()
            proto = _build_proto_sync({1: 1, 2: clean, 3: 26, 4: "en"}); endpoint = "/SubscribeWorkshopCode"
    except ValueError:
        STATE["social"][idx]["status"] = "Invalid Target"; return

    STATE["social"][idx]["status"] = "Sending"
    encrypted = aes_enc(proto)
    headers = {
        "User-Agent": "UnityPlayer/2018.4.12f1 (UnityWebRequest/1.0, libcurl/8.5.0-DEV)",
        "Accept": "*/*", "X-Ga-Sv": "1795270504", "Authorization": f"Bearer {jwt}",
        "X-Ga": "v1 1", "ReleaseVersion": RELEASE_VERSION,
        "Content-Type": "application/x-www-form-urlencoded",
        "X-Unity-Version": "2018.4.12f1",
    }
    def _post(): return requests.post(base_url.rstrip("/") + endpoint, headers=headers,
                                       data=encrypted, verify=False, timeout=15)
    try:
        resp = await asyncio.to_thread(_post); raw = resp.content
        if resp.status_code != 200:
            STATE["social"][idx]["status"] = f"HTTP {resp.status_code}"
        elif b"BR_WORKSHOP_INSUFFICIENT_MAPS" in raw:
            n = _first_varint(raw, 2); STATE["social"][idx]["status"] = f"Lock: {n if n else '?'} left"
        elif b"BR_WORKSHOP_ALREADY_FOLLOWED" in raw:
            STATE["social"][idx]["status"] = "Followed"
            if action_type == "Follow":
                STATE["bots"].setdefault(idx, {})["follow_done"] = True
                STATE["total_follows"] += 1
        elif b"BR_WORKSHOP" in raw and b"SUCCESS" not in raw:
            STATE["social"][idx]["status"] = "Failed"
        else:
            STATE["social"][idx]["status"] = "Success"
            if action_type == "Follow":
                STATE["bots"].setdefault(idx, {})["follow_done"] = True
                STATE["total_follows"] += 1
            elif action_type == "Subscribe":
                STATE["total_subscribes"] += 1
    except Exception:
        STATE["social"][idx]["status"] = "Net Err"

async def run_social_actions(accounts, action_type, target):
    tasks = [asyncio.create_task(execute_social_action(i, acc["uid"], acc.get("aid",""),
              action_type, target, acc["password"]))
             for i, acc in enumerate(accounts, 1)]
    if tasks: await asyncio.gather(*tasks, return_exceptions=True)

# ═══════════════════════════════════════════════════════════════════════
#  BOT CORE  (movement, phases)
# ═══════════════════════════════════════════════════════════════════════
MOVE_HZ = 5.0; MOVE_INTERVAL = 1.0 / MOVE_HZ; PUNCH_VEL = 390
PUNCH_STEP = PUNCH_VEL / MOVE_HZ; POSE_DASHING = 2; EMOTE_ID = 909000001; EMOTE_EVERY = 4.0
CMD_PLAYER_STATE_UPLOAD = 2001; CMD_EMOTE = 371

class MatchEnd(Exception): pass

def _pv(out, v):
    v = int(v)
    while v >= 0x80: out.append((v & 0x7F) | 0x80); v >>= 7
    out.append(v & 0x7F)
def _pzig(out, v): _pv(out, ((int(v) << 1) ^ (int(v) >> 63)) & 0xFFFFFFFFFFFFFFFF)
def _pfloat(out, f): _pv(out, struct.unpack("<I", struct.pack("<f", f))[0])

def _build_player_state(pid, pos, rot, tdir, vel, aim, ps=0, pp=0, plat=0, ping=0):
    o = bytearray(); _pv(o, pid)
    for v in [pos[0], pos[1], pos[2], rot[0], rot[1], rot[2], tdir[0], tdir[1],
              vel[0], vel[1], vel[2]]: _pzig(o, v)
    o.append(ps & 0xFF); o.append(pp & 0xFF)
    _pfloat(o, aim[0]); _pfloat(o, aim[1]); _pfloat(o, aim[2])
    _pv(o, plat); o.append(0); _pv(o, ping); o.append(0); _pv(o, 0); o.append(0)
    return bytes(o)

def _build_c2s_state(pid, pos, rot, tdir, vel, aim, server_time, ps=0, pp=0, ping=0):
    o = bytearray(_build_player_state(pid, pos, rot, tdir, vel, aim, ps=ps, pp=pp, ping=ping))
    _pv(o, server_time & 0xFFFFFFFF)
    return bytes(o)

def build_state_packet(body, key, mask, order_id=0):
    return build_pkt(CMD_PLAYER_STATE_UPLOAD, body, key, mask, reliable=False,
                     order_id=order_id, send_option=0, flags=1, msg_key=0x6A)

def build_emote_packet(key, mask):
    b = bytearray(); _pv(b, EMOTE_ID); b += b"\x00\x00\x00"; _pv(b, 0xFFFFFFFF)
    _pv(b, int(time.time() * 1000) & 0xFFFFFFFF); _pv(b, 0); _pzig(b, 0); b += b"\x00\x00\x00"
    return build_pkt(CMD_EMOTE, bytes(b), key, mask, reliable=True, order_id=0,
                     send_option=1, flags=1, msg_key=0x6A)

class BotBrain:
    def __init__(self, pid, spawn=None):
        self.pid = pid; self.my_pos = spawn; self.yaw = 0.0; self.random_goal = None
        self._last_sent_pos = spawn; self.joined_at = time.time()
    def build_next_state(self, now):
        if not self.my_pos: return None
        mx, my, mz = self.my_pos
        if not self.random_goal or math.hypot(self.random_goal[0] - mx, self.random_goal[1] - mz) < 100:
            self.random_goal = (mx + random.uniform(-500, 500), mz + random.uniform(-500, 500))
        gx, gz = self.random_goal; dx, dz = gx - mx, gz - mz; d = math.hypot(dx, dz)
        if d > 1:
            ux, uz = dx / d, dz / d; step = min(PUNCH_STEP, d)
            self.yaw = math.degrees(math.atan2(ux, uz)); new = (mx + ux * step, my, mz + uz * step)
        else: new = (mx, my, mz)
        old = self._last_sent_pos or self.my_pos
        nx, ny, nz = int(new[0]), int(new[1]), int(new[2]); ox, oy, oz = int(old[0]), int(old[1]), int(old[2])
        dx, dz = nx - ox, nz - oz; dist = math.hypot(dx, dz)
        if dist >= 1:
            ux, uz = dx / dist, dz / dist; vel = (int(ux * PUNCH_VEL), 0, int(uz * PUNCH_VEL))
            hdg = math.degrees(math.atan2(ux, uz)); hdg = ((hdg + 180.0) % 360.0) - 180.0
            rot = (int(hdg * 100), 0, 0); tdir = (int(ux * 100), int(uz * 100)); aim = (ux, 0.0, uz)
        else:
            vel = (0, 0, 0); rad = math.radians(self.yaw); fx, fz = math.sin(rad), math.cos(rad)
            hdg = ((self.yaw + 180.0) % 360.0) - 180.0; rot = (int(hdg * 100), 0, 0)
            tdir = (int(fx * 100), int(fz * 100)); aim = (fx, 0.0, fz)
        self.my_pos = new; self._last_sent_pos = new
        return _build_c2s_state(self.pid, (nx, ny, nz), rot, tdir, vel, aim,
                                int((now - self.joined_at) * 1000.0) & 0xFFFFFFFF,
                                ps=0, pp=POSE_DASHING, ping=90)

# ── Phases ─────────────────────────────────────────────────────────────
def phase1_build_match_start(map_code):
    hdr("PHASE ① MATCH-START")
    try: parse_map_code(map_code)
    except ValueError as e: err(f"map fail: {e}"); raise
    return build_match_start(map_code)

async def phase2_send_and_wait(uid, pwd, raw_match_start, bot_idx):
    hdr("PHASE ② TCP LOGIN")
    STATE["bots"][bot_idx]["status"] = "Logging in"
    cache = load_jwt_cache(); s = cache.get(str(uid))
    is_valid = False
    if s:
        if "expires_at" in s: is_valid = time.time() < s["expires_at"]
        elif "saved_at" in s: is_valid = (time.time() - s["saved_at"]) < JWT_TTL
    if is_valid:
        if isinstance(s.get("key"), str): s["key"] = bytes.fromhex(s["key"])
        if isinstance(s.get("iv"), str):  s["iv"]  = bytes.fromhex(s["iv"])
    else: s = None
    if not s or int(s.get("acc_id", 0)) == 0:
        info(f"Bot {bot_idx} JWT expired. Re-login...")
        try: s = await asyncio.to_thread(login, uid, pwd); save_jwt_cache(uid, s); ok(f"Bot {bot_idx} JWT regenerated!")
        except Exception as e: err(f"Bot {bot_idx} login fail: {e}"); return None
    try:
        reader, writer = await asyncio.wait_for(
            asyncio.open_connection(s["host"], int(s["port"])), timeout=CONNECT_TIMEOUT)
    except Exception as e: err(f"Bot {bot_idx} TCP fail: {e}"); return None
    fr = FrameReader(reader); stop = asyncio.Event(); bt = None
    try:
        enc = aes_enc(s["jwt"].encode(), s["key"], s["iv"])
        auth = (bytes([0x83, region_byte(s["region"])]) +
                int(s["acc_id"]).to_bytes(8, "big") + int(s["kts"]).to_bytes(4, "big") +
                bytes(4) + len(enc).to_bytes(4, "big") + enc)
        writer.write(auth); await writer.drain()
        t0 = time.time()
        while time.time() - t0 < 3.0:
            f = await fr.next_frame(timeout=0.5)
            if not f and reader.at_eof(): return None
        c = (_fv(1, 6) + _fb(2, _fv(1, 3) + _fs(2, "2019121269") + _fv(3, 2) + _fv(4, 1)))
        writer.write(tcp_frame("1d14", c, s["key"], s["iv"])); await writer.drain()
        await asyncio.sleep(0.4)
        writer.write(tcp_frame(MATCH_OPCODE, bytes.fromhex(PRELOAD_HEX), s["key"], s["iv"])); await writer.drain()
        pre_deadline = time.time() + PRELOAD_WAIT
        while time.time() < pre_deadline:
            f = await fr.next_frame(timeout=0.5)
            if not f: continue
            op, payload = f
            if op.hex() == "0e00" and to_int(_first(parse_proto(payload), 4)) == 32: break
        writer.write(tcp_frame(MATCH_OPCODE, raw_match_start, s["key"], s["iv"])); await writer.drain()
        bt = asyncio.create_task(tcp_heartbeat(writer, stop, s, TCP_HEARTBEAT))
        deadline = time.time() + MATCH_WAIT
        while time.time() < deadline:
            f = await fr.next_frame(timeout=1.0)
            if not f: continue
            op, payload = f
            if op.hex() == "0e00":
                tree = parse_proto(payload)
                if to_int(_first(tree, 4)) == 16:
                    inner = _first(tree, 5)
                    if isinstance(inner, (bytes, bytearray)): inner = parse_proto(bytes(inner))
                    if isinstance(inner, dict):
                        udp = to_str(_first(inner, 2))
                        if udp and ":" in udp:
                            return {"writer": writer, "fr": fr, "stop": stop, "session": s,
                                    "udp_server": udp, "udp_key": to_str(_first(inner, 3)),
                                    "match_id": to_int(_first(inner, 1)), "account_id": int(s["acc_id"]),
                                    "room_code": to_str(_first(inner, 19)),
                                    "room_name": to_str(_first(inner, 20)),
                                    "mask": _resolve_mask(to_str(_first(inner, 42)))}
                udp = find_udp_server(tree)
                if udp:
                    return {"writer": writer, "fr": fr, "stop": stop, "session": s,
                            "udp_server": udp, "udp_key": "", "match_id": 0,
                            "account_id": int(s["acc_id"]), "room_code": "", "room_name": "",
                            "mask": DEFAULT_MASK}
        err(f"Bot {bot_idx} no UDP server"); return None
    except Exception as e: err(f"Bot {bot_idx} TCP error: {e}"); return None
    finally:
        if bt and not bt.done(): stop.set(); bt.cancel()

async def phase3_start_udp(match, duration, bot_idx, map_code):
    hdr("PHASE ③ UDP JOIN")
    STATE["bots"][bot_idx]["status"] = "Joining UDP"
    udp_server = match["udp_server"]; mask = match["mask"] or DEFAULT_MASK
    try: key = bytes.fromhex(match["udp_key"])
    except Exception: return None
    if len(key) != 16: return None
    if not (isinstance(mask, str) and len(mask) == 5 and sorted(mask) == list("01234")):
        mask = DEFAULT_MASK
    try: host, port = udp_server.rsplit(":", 1); port = int(port)
    except Exception: return None
    ip = await resolve_host(host); loop = asyncio.get_running_loop()
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); sock.setblocking(False)
    try: sock.connect((ip, port))
    except Exception: sock.close(); return None

    recv_orders, ack_next = set(), [0]; stop_udp = asyncio.Event()
    t_448 = [time.time()]; cmd176_seen = [False]; brain = None; brain_task = None
    timing = {"entity": None, "ended": False}; result = {"duration": None}

    async def tx(pkt): 
        try: await loop.sock_sendall(sock, pkt)
        except OSError: pass
    async def send_ack(n): await tx(pkt_ack(n, key, mask, msg_key=0x68))
    def body_plain(h, pkt):
        off = h["header_len"] + h.get("extra", 0); b = pkt[off:off + h["length"]]
        if not b: return b
        if h["flags"] & 1:
            pl = udp_dec(b, key); stripped = strip_tea_pad(pl)
            if h["cmd"] == 176 and len(stripped) < 10: return pl
            return stripped
        return b
    async def handle(data):
        nonlocal brain, brain_task
        h = decode_header(data, key, mask)
        if not h: return
        if h["cmd"] in (4, 103):
            timing["ended"] = True; raise MatchEnd()
        if h["cmd"] == 176 and not cmd176_seen[0]:
            plain = body_plain(h, data); eid, aid, pos = parse_player_sync(plain)
            if eid == 0:
                try: eid = struct.unpack("<I", plain[:4])[0]
                except Exception: pass
            if eid != 0:
                cmd176_seen[0] = True
                STATE["bots"][bot_idx]["entity"] = eid
                STATE["bots"][bot_idx]["status"] = "Playing"
                timing["entity"] = time.time()
                ok(f"Bot {bot_idx} Entity: {eid}")
                if brain is None:
                    brain = BotBrain(eid, spawn=pos)
                    brain_task = asyncio.create_task(_brain_loop(brain, key, mask, sock, loop))
        if h.get("orderId") is not None and h["cmd"] != 2:
            recv_orders.add(h["orderId"])
            while ack_next[0] in recv_orders: ack_next[0] += 1
            await send_ack(ack_next[0])
    async def _brain_loop(brain, key, mask, sock, loop):
        last_emote, order = time.time(), 0
        while not stop_udp.is_set():
            try:
                now = time.time(); body = brain.build_next_state(now)
                if body:
                    await loop.sock_sendall(sock, build_state_packet(body, key, mask, order_id=order))
                    order = (order + 1) & 0xFFFF
                if now - last_emote > EMOTE_EVERY:
                    await loop.sock_sendall(sock, build_emote_packet(key, mask)); last_emote = now
            except Exception: break
            try: await asyncio.wait_for(stop_udp.wait(), timeout=MOVE_INTERVAL); break
            except asyncio.TimeoutError: pass
    try:
        suffix = str(1000 + secrets.randbelow(9000))
        await tx(pkt_hello(str(match["account_id"]), suffix, key, mask)); await asyncio.sleep(1.0)
        await tx(pkt_auth3043(1, match["account_id"], match["match_id"], key, mask, 0, 0x60))
        await tx(pkt_auth3043(2, match["account_id"], match["match_id"], key, mask, 1, 0x5E))
        await asyncio.sleep(1.0); t_448[0] = time.time()
        await tx(pkt_auth448(match["account_id"], match["match_id"], match["room_code"],
                              match["room_name"], key, mask, 2, 0x60))
        ent_deadline = time.time() + ENTITY_WAIT
        while time.time() < ent_deadline and not cmd176_seen[0]:
            try: data = await asyncio.wait_for(loop.sock_recv(sock, 65536), timeout=0.4)
            except asyncio.TimeoutError: continue
            if data: await handle(data)
        if not cmd176_seen[0]: warn(f"Bot {bot_idx} Entity timeout")
        if duration > 0 or SEQ_MODE:
            ping_task = asyncio.create_task(_udp_ping(key, mask, sock, loop, stop_udp, t_448))
            idle_task = asyncio.create_task(_udp_idle(key, mask, sock, loop, stop_udp))
            t0 = time.time()
            while True:
                if not SEQ_MODE and duration > 0 and (time.time() - t0 >= duration): break
                STATE["bots"][bot_idx]["time_in_match"] = time.time() - t0
                try: data = await asyncio.wait_for(loop.sock_recv(sock, 65536), timeout=0.5)
                except asyncio.TimeoutError: continue
                if data: await handle(data)
    except MatchEnd:
        info(f"Bot {bot_idx} SERVER END")
    except Exception as e:
        err(f"Bot {bot_idx} UDP: {e}")
    finally:
        stop_udp.set()
        if brain_task: brain_task.cancel()
        try: ping_task.cancel(); idle_task.cancel()
        except Exception: pass
        sock.close()
        if timing["entity"] and timing["ended"]:
            actual = time.time() - timing["entity"]
            result["duration"] = actual
            ok(f"Bot {bot_idx} actual: {actual:.1f}s")
    return result["duration"]

async def _udp_ping(key, mask, sock, loop, stop_udp, t_448):
    while not stop_udp.is_set():
        tick = (PING_TICK_BASE - 2 * int((time.time() - t_448[0]) * 1000)) & 0xFFFFFFFF
        try: await loop.sock_sendall(sock, pkt_ping(tick, key, mask))
        except Exception: break
        try: await asyncio.wait_for(stop_udp.wait(), timeout=PING_INTERVAL); break
        except asyncio.TimeoutError: pass

async def _udp_idle(key, mask, sock, loop, stop_udp):
    while not stop_udp.is_set():
        try: await loop.sock_sendall(sock, pkt_idle(key, mask))
        except Exception: break
        try: await asyncio.wait_for(stop_udp.wait(), timeout=IDLE_INTERVAL); break
        except asyncio.TimeoutError: pass

async def run_one_match(uid, pwd, map_code, duration, bot_idx):
    try: raw = phase1_build_match_start(map_code)
    except Exception: return None
    STATE["bots"][bot_idx]["map"] = map_code
    STATE["bots"][bot_idx]["time_in_match"] = 0
    match = await phase2_send_and_wait(uid, pwd, raw, bot_idx)
    if not match: return None
    try:
        actual = await phase3_start_udp(match, duration, bot_idx, map_code)
        STATE["total_matches"] += 1
        STATE["bots"][bot_idx]["matches_played"] = STATE["bots"][bot_idx].get("matches_played", 0) + 1
        save_history()
        return actual
    finally:
        STATE["bots"][bot_idx]["status"] = "Cooldown"
        match["stop"].set()
        try: match["writer"].close(); await match["writer"].wait_closed()
        except Exception: pass

async def loop_matches(idx, total, uid, pwd, aid, rejoin_delay):
    STATE["bots"][idx] = {"uid": uid, "aid": aid, "status": "Booting", "map": "-",
                          "entity": "-", "matches_played": 0, "time_in_match": 0,
                          "total_time_played": 0, "follow_done": False}
    start_idx_0 = START_MAP_IDX - 1; end_idx_0 = END_MAP_IDX - 1
    bot_map_idx = start_idx_0
    if RESUME_MODE:
        saved = get_bot_progress_map(SEQ_MODE, uid)
        if saved is not None and start_idx_0 <= saved <= end_idx_0:
            bot_map_idx = saved; ok(f"Bot {idx} 💾 RESUME map #{saved+1}")

    while True:
        if SEQ_MODE:
            map_code = MAP_CODES[bot_map_idx]
            info(f"Bot {idx} → SEQ Map #{bot_map_idx+1}")
            save_progress(True, uid, bot_map_idx)
            if not STATE["bots"][idx].get(f"sub_done_{bot_map_idx}"):
                asyncio.create_task(execute_social_action(idx, uid, aid, "Subscribe", map_code, pwd, True))
                STATE["bots"][idx][f"sub_done_{bot_map_idx}"] = True
            try: await run_one_match(uid, pwd, map_code, 0, idx)
            except Exception as e: err(f"Bot {idx}: {e}")
            if AUTO_FOLLOW_ENABLED and AUTO_FOLLOW_TARGET and not STATE["bots"][idx].get("follow_done"):
                await execute_social_action(idx, uid, aid, "Follow", AUTO_FOLLOW_TARGET, pwd, True)
            await asyncio.sleep(rejoin_delay)
            bot_map_idx += 1
            if bot_map_idx > end_idx_0: bot_map_idx = start_idx_0
            continue
        map_code = MAP_CODES[bot_map_idx]
        info(f"Bot {idx} → TIMER Map #{bot_map_idx+1}")
        save_progress(False, uid, bot_map_idx)
        if not STATE["bots"][idx].get(f"sub_done_{bot_map_idx}"):
            asyncio.create_task(execute_social_action(idx, uid, aid, "Subscribe", map_code, pwd, True))
            STATE["bots"][idx][f"sub_done_{bot_map_idx}"] = True
        try: await run_one_match(uid, pwd, map_code, ROTATION["hold_secs"], idx)
        except Exception as e: err(f"Bot {idx}: {e}")
        if AUTO_FOLLOW_ENABLED and AUTO_FOLLOW_TARGET and not STATE["bots"][idx].get("follow_done"):
            await execute_social_action(idx, uid, aid, "Follow", AUTO_FOLLOW_TARGET, pwd, True)
        await asyncio.sleep(rejoin_delay)
        bot_map_idx += 1
        if bot_map_idx > end_idx_0: bot_map_idx = start_idx_0

# ═══════════════════════════════════════════════════════════════════════
#  BOT MANAGER
# ═══════════════════════════════════════════════════════════════════════
class BotManager:
    def __init__(self):
        self.tasks = {}; self.running = False; self.started_at = 0
    async def start(self, cfg):
        global SEQ_MODE, START_MAP_IDX, END_MAP_IDX, RESUME_MODE, AUTO_FOLLOW_TARGET, AUTO_FOLLOW_ENABLED
        if self.running: return {"ok": False, "error": "already running"}
        SEQ_MODE = bool(cfg.get("seq_mode", True))
        START_MAP_IDX = int(cfg.get("start_map", 1))
        END_MAP_IDX = int(cfg.get("end_map", 24))
        RESUME_MODE = bool(cfg.get("resume", True))
        AUTO_FOLLOW_TARGET = str(cfg.get("target", "")).strip()
        AUTO_FOLLOW_ENABLED = bool(cfg.get("auto_follow", False))
        save_config()
        accounts = load_accounts(cfg.get("accounts_file", "accounts.json"))
        if not accounts: return {"ok": False, "error": "no accounts found"}
        hold = float(cfg.get("hold_secs", 60.0))
        sync = float(cfg.get("sync_secs", 10.0))
        rejoin = float(cfg.get("rejoin_delay", 2.0))
        ROTATION["maps"] = list(MAP_CODES); ROTATION["hold_secs"] = hold
        ROTATION["sync_secs"] = sync; ROTATION["start_time"] = time.time()
        ROTATION["range_start"] = START_MAP_IDX - 1; ROTATION["range_end"] = END_MAP_IDX - 1
        STATE["start_time"] = time.time()
        self.tasks = {}
        self.running = True; self.started_at = time.time()
        for i, acc in enumerate(accounts, 1):
            self.tasks[i] = asyncio.create_task(
                loop_matches(i, len(accounts), acc["uid"], acc["password"], acc.get("aid", ""), rejoin))
        info(f"Engine started · {len(accounts)} bots")
        return {"ok": True, "bots": len(accounts)}
    async def stop(self):
        if not self.running: return {"ok": False, "error": "not running"}
        for t in self.tasks.values(): t.cancel()
        await asyncio.gather(*self.tasks.values(), return_exceptions=True)
        self.tasks.clear(); self.running = False
        info("Engine stopped")
        return {"ok": True}

manager = BotManager()

def snapshot():
    return {
        "bots": dict(STATE["bots"]),
        "logs": list(STATE["logs"]),
        "error_logs": list(STATE["error_logs"]),
        "social": dict(STATE["social"]),
        "totals": {
            "matches": STATE["total_matches"],
            "errors": STATE["total_errors"],
            "follows": STATE["total_follows"],
            "subscribes": STATE["total_subscribes"],
        },
        "uptime": time.time() - STATE["start_time"],
        "running": manager.running,
        "target": AUTO_FOLLOW_TARGET,
        "auto_follow": AUTO_FOLLOW_ENABLED,
        "seq_mode": SEQ_MODE,
        "maps_total": len(MAP_CODES),
        "server_time": time.time(),
    }

# ═══════════════════════════════════════════════════════════════════════
#  FASTAPI
# ═══════════════════════════════════════════════════════════════════════
@asynccontextmanager
async def lifespan(app):
    global _main_loop
    _main_loop = asyncio.get_running_loop()
    load_config()
    asyncio.create_task(_push_loop())
    print("\n[+] ✅ OBSIDIAN server ready — open http://localhost:8000\n", flush=True)
    yield
    print("\n[+] Server shutting down\n", flush=True)

app = FastAPI(lifespan=lifespan)

@app.get("/")
async def root():
    if not os.path.exists("index.html"):
        return JSONResponse(
            {"error": "index.html not found in current directory. Make sure it's in same folder as vn.py."},
            status_code=500,
        )
    return FileResponse("index.html")

@app.get("/health")
async def health():
    return {"ok": True, "running": manager.running, "bots": len(STATE["bots"])}

@app.websocket("/ws")
async def ws_ep(ws: WebSocket):
    await ws.accept(); ws_mgr.clients.add(ws)
    try:
        await ws.send_json({"type": "init", "data": snapshot()})
        while True: await ws.receive_text()
    except WebSocketDisconnect: ws_mgr.clients.discard(ws)
    except Exception: ws_mgr.clients.discard(ws)

@app.get("/api/status")
async def api_status(): return snapshot()

@app.post("/api/start")
async def api_start(body: dict): return await manager.start(body)

@app.post("/api/stop")
async def api_stop(): return await manager.stop()

@app.get("/api/maps")
async def api_maps(): return {"maps": MAP_CODES}

@app.get("/api/accounts")
async def api_accounts(): return {"accounts": load_accounts()}

@app.post("/api/social")
async def api_social(body: dict):
    action = body.get("action", "Follow"); target = body.get("target", "")
    if not target: return {"ok": False, "error": "no target"}
    accounts = load_accounts()
    if not accounts: return {"ok": False, "error": "no accounts"}
    asyncio.create_task(run_social_actions(accounts, action, target))
    return {"ok": True, "queued": len(accounts)}

@app.post("/api/config")
async def api_config(body: dict):
    global AUTO_FOLLOW_TARGET, AUTO_FOLLOW_ENABLED
    if "target" in body: AUTO_FOLLOW_TARGET = str(body["target"]).strip()
    if "auto_follow" in body: AUTO_FOLLOW_ENABLED = bool(body["auto_follow"])
    save_config()
    return {"ok": True}

async def _push_loop():
    while True:
        try:
            if ws_mgr.clients: await ws_mgr.broadcast({"type": "status", "data": snapshot()})
        except Exception: pass
        await asyncio.sleep(0.8)

if __name__ == "__main__":
    print("\n╔══════════════════════════════════════════════════╗")
    print("║  OBSIDIAN NETRUNNER OS · YEAR 2080 EDITION       ║")
    print("║  →  http://localhost:8000                       ║")
    print("╚══════════════════════════════════════════════════╝\n")
    uvicorn.run(app, host="0.0.0.0", port=8000, log_level="info")